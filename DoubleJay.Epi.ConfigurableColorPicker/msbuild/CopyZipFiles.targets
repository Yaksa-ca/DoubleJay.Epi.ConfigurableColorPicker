<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <ItemGroup>
    <_DoubleJayColorPickerModule Include="$(MSBuildThisFileDirectory)..\contentFiles\any\any\modules\_protected\DoubleJay.Epi.ConfigurableColorPicker\DoubleJay.Epi.ConfigurableColorPicker.zip" />
    <Content Include="@(_DoubleJayColorPickerModule)">
      <Link>modules\_protected\DoubleJay.Epi.ConfigurableColorPicker\DoubleJay.Epi.ConfigurableColorPicker.zip</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <Target Name="CopyDoubleJayColorPickerZip" BeforeTargets="PrepareForBuild">
    <Copy SourceFiles="@(_DoubleJayColorPickerModule)" DestinationFolder="$(MSBuildProjectDirectory)\modules\_protected\DoubleJay.Epi.ConfigurableColorPicker" SkipUnchangedFiles="true" />
  </Target>
</Project>
